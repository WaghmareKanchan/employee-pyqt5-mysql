/* Meridian Systems — simple, clean desktop theme */

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1f2937;
    background-color: #f6f7fb;
}

QMainWindow {
    background-color: #f6f7fb;
}

#card {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 28px;
    border: 1px solid #e5e7eb;
}

#appTitle {
    font-size: 22px;
    font-weight: 700;
    color: #1e3a8a;
}

#appSubtitle {
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 6px;
}

#pageTitle {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 6px;
}

#hintLabel {
    color: #6b7280;
    font-size: 11px;
}

#errorLabel {
    color: #b91c1c;
    font-size: 12px;
}

QGroupBox {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: 600;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #374151;
}

QLineEdit, QComboBox, QDateEdit, QTimeEdit, QSpinBox, QDoubleSpinBox, QTextEdit {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 8px;
    background-color: #ffffff;
    selection-background-color: #93c5fd;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 1px solid #2563eb;
}

QPushButton {
    background-color: #e5e7eb;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 7px 14px;
}

QPushButton:hover {
    background-color: #d1d5db;
}

QPushButton:pressed {
    background-color: #9ca3af;
}

QPushButton#primaryButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#primaryButton:pressed {
    background-color: #1e40af;
}

QPushButton#dangerButton {
    background-color: #ffffff;
    color: #b91c1c;
    border: 1px solid #fca5a5;
    font-weight: 600;
}

QPushButton#dangerButton:hover {
    background-color: #fee2e2;
}

QPushButton#dangerButton:pressed {
    background-color: #fecaca;
}

QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #2563eb;
    text-decoration: underline;
    padding: 2px;
}

QPushButton#linkButton:hover {
    color: #1d4ed8;
}

QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    background: #ffffff;
}

QTabBar::tab {
    background: #eef0f5;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background: #ffffff;
    font-weight: 600;
    color: #1e3a8a;
}

QTableWidget {
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    gridline-color: #eef0f5;
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
}

QHeaderView::section {
    background-color: #eef0f5;
    padding: 6px;
    border: none;
    font-weight: 600;
    color: #374151;
}

#statCard {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 14px;
}

#statValue {
    font-size: 22px;
    font-weight: 700;
    color: #2563eb;
}

#statTitle {
    color: #6b7280;
    font-size: 11px;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
}
